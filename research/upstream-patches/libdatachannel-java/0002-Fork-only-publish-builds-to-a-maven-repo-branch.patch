From daaafcb0bd24aee3c9be9cf2d8b16f4633f331fc Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 9 Nov 2026 19:20:12 +0000
Subject: [PATCH 2/2] Fork only: publish builds to a maven-repo branch

Builds every native with native-builds.yml, which now also applies
patches/<submodule>/*.patch, and publishes libdatachannel-java and
libdatachannel-java-arch-detect as a plain Maven repository on the
maven-repo branch, for testing without access to repo.opencollab.dev.
Not meant for upstream.

Written with assistance from Claude Code.
---
 .github/workflows/native-builds.yml | 11 ++++
 .github/workflows/publish-fork.yml  | 89 +++++++++++++++++++++++++++++
 2 files changed, 100 insertions(+)
 create mode 100644 .github/workflows/publish-fork.yml

diff --git a/.github/workflows/native-builds.yml b/.github/workflows/native-builds.yml
index 6676627..5cb22e1 100644
--- a/.github/workflows/native-builds.yml
+++ b/.github/workflows/native-builds.yml
@@ -90,6 +90,17 @@ jobs:
         with:
           fetch-depth: 0
           submodules: recursive
+      # Fork-only: patches/<submodule path>/*.patch are applied to that submodule, for fixes not published in a submodule yet
+      - name: Apply local submodule patches
+        shell: bash
+        run: |
+          if [ -d patches ]; then
+            find patches -name '*.patch' | sort | while read -r patch; do
+              target="$(dirname "${patch#patches/}")"
+              echo "Applying $patch to $target"
+              git -C "$target" apply --verbose "$GITHUB_WORKSPACE/$patch"
+            done
+          fi
       - uses: actions/setup-java@v5
         with:
           java-version: '17'
diff --git a/.github/workflows/publish-fork.yml b/.github/workflows/publish-fork.yml
new file mode 100644
index 0000000..baa28fa
--- /dev/null
+++ b/.github/workflows/publish-fork.yml
@@ -0,0 +1,89 @@
+name: Publish to this fork's maven-repo branch
+
+# Fork-only: builds every native like publish-opencollab.yml, then publishes the artifacts as a plain Maven
+# repository on the maven-repo branch, readable without credentials at
+# https://raw.githubusercontent.com/<owner>/<repo>/maven-repo/
+
+on:
+  push:
+    branches: [ 'fix-*', 'libdatachannel-java-*' ]
+  workflow_dispatch:
+
+concurrency:
+  group: publish-fork
+  cancel-in-progress: false
+
+permissions:
+  contents: write
+
+env:
+  TARGETS: linux-glibc-x86_64,linux-glibc-aarch64,linux-musl-x86_64,linux-musl-aarch64,windows-x86_64,windows-aarch64,macos-arm64,macos-x86_64
+
+jobs:
+  build-natives:
+    uses: ./.github/workflows/native-builds.yml
+
+  publish:
+    name: Publish to maven-repo
+    needs: [ build-natives ]
+    runs-on: ubuntu-latest
+    steps:
+    - uses: actions/checkout@v6
+      with:
+        fetch-depth: '0'
+        submodules: recursive
+
+    - name: Set up JDK 17
+      uses: actions/setup-java@v5
+      with:
+        java-version: '17'
+        distribution: 'temurin'
+
+    - name: Setup Gradle
+      uses: gradle/actions/setup-gradle@v5
+
+    - name: Download native libraries
+      uses: actions/download-artifact@v7
+      with:
+        pattern: libdatachannel-*
+        path: artifacts
+
+    - name: Publish to a local Maven repository
+      id: publish
+      run: |
+        version="0.24.6.1-fork-$(git rev-parse --short=10 HEAD)"
+        echo "version=$version" >> "$GITHUB_OUTPUT"
+        ./gradlew --no-configuration-cache \
+          :publishToMavenLocal :libdatachannel-java-arch-detect:publishToMavenLocal \
+          "-Dmaven.repo.local=$PWD/m2" \
+          "-Plibdatachannel.development-version=$version" \
+          -Plibdatachannel.targets="$TARGETS" \
+          -Plibdatachannel.linux-glibc-x86_64.prebuilt-path=artifacts/libdatachannel-linux-glibc-x86_64/libdatachannel-java.so \
+          -Plibdatachannel.linux-glibc-aarch64.prebuilt-path=artifacts/libdatachannel-linux-glibc-aarch64/libdatachannel-java.so \
+          -Plibdatachannel.linux-musl-x86_64.prebuilt-path=artifacts/libdatachannel-linux-musl-x86_64/libdatachannel-java.so \
+          -Plibdatachannel.linux-musl-aarch64.prebuilt-path=artifacts/libdatachannel-linux-musl-aarch64/libdatachannel-java.so \
+          -Plibdatachannel.windows-x86_64.prebuilt-path=artifacts/libdatachannel-windows-x86_64/libdatachannel-java.dll \
+          -Plibdatachannel.windows-aarch64.prebuilt-path=artifacts/libdatachannel-windows-aarch64/libdatachannel-java.dll \
+          -Plibdatachannel.macos-arm64.prebuilt-path=artifacts/libdatachannel-macos-arm64/libdatachannel-java.dylib \
+          -Plibdatachannel.macos-x86_64.prebuilt-path=artifacts/libdatachannel-macos-x86_64/libdatachannel-java.dylib
+        find m2 -type f | sort
+
+    - name: Push to the maven-repo branch
+      env:
+        VERSION: ${{ steps.publish.outputs.version }}
+      run: |
+        git config user.name "github-actions[bot]"
+        git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+        if git fetch origin maven-repo; then
+          git worktree add repo origin/maven-repo
+          git -C repo checkout -B maven-repo
+        else
+          git worktree add --detach repo
+          git -C repo checkout --orphan maven-repo
+          git -C repo rm -rfq .
+        fi
+        cp -r m2/dev repo/
+        git -C repo add dev
+        git -C repo commit -m "libdatachannel-java $VERSION from ${GITHUB_REF_NAME}@${GITHUB_SHA}"
+        git -C repo push origin maven-repo
+        echo "Published dev.opencollab:libdatachannel-java(-arch-detect):$VERSION" >> "$GITHUB_STEP_SUMMARY"
-- 
